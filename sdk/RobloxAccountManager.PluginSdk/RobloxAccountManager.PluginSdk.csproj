    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>RobloxAccountManager.PluginSdk</PackageId>
    <Version>1.0.1</Version>
