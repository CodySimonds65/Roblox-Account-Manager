<Window Style="{StaticResource {x:Type Window}}" x:Class="RobloxAltClient.CompatibilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility diagnostics" Height="590" Width="760" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,15">
            <TextBlock Text="Compatibility" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="System components and launcher readiness"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="4">
            <ListBox x:Name="ChecksList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateLabel}" Value="READY">
                                                    <Setter Property="Foreground" Value="#8FCBA5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateLabel}" Value="WARNING">
                                                    <Setter Property="Foreground" Value="#E5B975" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Copied reports exclude profiles, URLs, cookies and local paths."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Copy diagnostics" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" Width="90" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
