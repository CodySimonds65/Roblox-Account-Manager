<Window x:Class="RobloxAltClient.CompatibilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility diagnostics" Height="590" Width="760" MinHeight="480" MinWidth="640"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,15">
            <TextBlock Text="Compatibility diagnostics" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="A privacy-safe readiness check for this PC."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="10">
            <ListBox x:Name="ChecksList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0D1016" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" Background="#211D38" CornerRadius="7" Padding="7,3">
                                    <TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="Bold" Foreground="#B5A7FF" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="No profiles, URLs, cookies, or local paths are included."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy diagnostics" Click="Copy_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" Width="90" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
