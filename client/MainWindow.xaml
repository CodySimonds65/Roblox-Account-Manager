<Window x:Class="RobloxAltClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Alt Client" Height="860" Width="1380" MinHeight="700" MinWidth="1080"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="17">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,1,2,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="R" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Alt Client" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Roblox launcher" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="2,0,2,10">
                    <TextBlock Text="ACCOUNT PROFILES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Border HorizontalAlignment="Right" Background="#211D38" CornerRadius="8" Padding="7,2">
                        <TextBlock Text="MULTI-SELECT" FontSize="9" FontWeight="Bold" Foreground="#B5A7FF" />
                    </Border>
                </Grid>

                <ListBox x:Name="AccountsList" Grid.Row="2" SelectionMode="Multiple" AllowDrop="True"
                         SelectionChanged="AccountsList_SelectionChanged"
                         PreviewMouseLeftButtonDown="AccountsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AccountsList_PreviewMouseMove" Drop="AccountsList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}">
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Group}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="★" Foreground="#F5C451" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button x:Name="AddAccountButton" Content="＋  Add account profile" Click="AddAccount_Click" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Select all" Click="SelectAllAccounts_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="Select none" Click="SelectNoAccounts_Click" Style="{StaticResource CompactButton}" Margin="4,0,0,0" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EditAccountButton" Content="Edit profile" Click="EditAccount_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="↑" ToolTip="Move profile up" Click="MoveAccountUp_Click" Style="{StaticResource CompactButton}" Width="34" Margin="0,0,5,0" />
                        <Button Grid.Column="2" Content="↓" ToolTip="Move profile down" Click="MoveAccountDown_Click" Style="{StaticResource CompactButton}" Width="34" />
                    </Grid>
                    <Button x:Name="RemoveAccountButton" Content="Remove selected session" Click="RemoveAccount_Click"
                            Style="{StaticResource DangerButton}" Margin="0,8,0,0" />
                    <TextBlock Text="Sessions stay isolated and local to this PC." TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="3,13,3,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <Grid Margin="2,3,2,18">
                <StackPanel>
                    <TextBlock Text="Launch workspace" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Choose profiles, pick a game, and launch every client in sequence."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Settings" Click="Settings_Click" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="Diagnostics" Click="Diagnostics_Click" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" Margin="0,0,8,0" />
                    <Border Background="#10261F" BorderBrush="#1C4B3C" BorderThickness="1" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="LOCAL ONLY" FontSize="10" FontWeight="Bold" Foreground="#7DE6BC" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GAME PRESET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="GamePicker" SelectionChanged="GamePicker_SelectionChanged" />
                            <Button x:Name="AddGamePresetButton" Grid.Column="1" Content="＋" ToolTip="Add game preset"
                                    Click="AddGamePreset_Click" Style="{StaticResource CompactButton}"
                                    Width="34" Height="34" Padding="0" Margin="7,0,0,0" />
                            <Button x:Name="RemoveGamePresetButton" Grid.Column="2" Content="−" ToolTip="Remove selected preset"
                                    Click="RemoveGamePreset_Click" Style="{StaticResource CompactButton}"
                                    Width="34" Height="34" Padding="0" Margin="5,0,0,0" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="CUSTOM ROBLOX URL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,6" />
                        <TextBox x:Name="CustomUrlBox" Visibility="Collapsed" Text="https://www.roblox.com/games/" />
                        <Border x:Name="PresetHint" Background="#0D1016" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="11,8">
                            <TextBlock x:Name="PresetHintText" Text="Using the selected game preset"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="OpenLoginButton" Grid.Column="2" Content="Login / Home" Click="OpenLogin_Click"
                            Style="{StaticResource SecondaryButton}" Margin="12,16,8,0" VerticalAlignment="Top" />
                    <Button x:Name="AutoLaunchButton" Grid.Column="3" Content="▶  Auto-launch selected" Click="PrepareLaunch_Click"
                            Margin="0,16,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource ElevatedBrush}" Margin="0">
                        <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                            <TextBlock x:Name="ActiveProfileText" Text="No profile selected" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="  •  ISOLATED ROBLOX SESSION" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="LaunchProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                    <Grid x:Name="BrowserHost" Grid.Row="2" Background="#0B0D12">
                        <StackPanel x:Name="BrowserPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="16" Background="#1B1E29" HorizontalAlignment="Center">
                                <TextBlock Text="↗" FontSize="24" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select an account profile" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Text="Its private Roblox session will open here."
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="  Live diagnostics" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Timeout" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="LaunchTimeoutPicker" Width="68" Height="29" SelectedIndex="1" Margin="0,0,7,0">
                                <ComboBoxItem Content="30s" Tag="30" />
                                <ComboBoxItem Content="45s" Tag="45" />
                                <ComboBoxItem Content="60s" Tag="60" />
                                <ComboBoxItem Content="90s" Tag="90" />
                            </ComboBox>
                            <CheckBox x:Name="ContinueOnFailureCheckBox" Content="Continue on failure" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="CancelLaunchButton" Content="Cancel" Style="{StaticResource CompactButton}"
                                    Click="CancelLaunch_Click" IsEnabled="False" Margin="0,0,6,0" />
                            <Button x:Name="RetryFailedButton" Content="Retry failed" Style="{StaticResource CompactButton}"
                                    Click="RetryFailed_Click" IsEnabled="False" Margin="0,0,6,0" />
                            <Button Content="Copy log" Style="{StaticResource CompactButton}" Click="CopyActivity_Click" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LaunchQueueList" Grid.Row="1" Margin="0,0,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1016" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,7" Width="160" Margin="0,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#B5A7FF" />
                                            <TextBlock Text="  •  " FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Width="84" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono" FontSize="12" Background="#0B0D12" Foreground="#CBD1DE"
                             BorderBrush="#202531" Padding="10,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
