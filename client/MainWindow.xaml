<Window Style="{StaticResource {x:Type Window}}" x:Class="RobloxAltClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RobloxAltClient"
        Title="Roblox Account Manager" Height="860" Width="1380" MinHeight="700" MinWidth="1080"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="2,4,2,22">
                    <TextBlock Text="Accounts" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Select accounts to launch" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Profiles" FontSize="12" Margin="2,0,2,8"
                           Foreground="{StaticResource MutedTextBrush}" />

                <ListBox x:Name="AccountsList" Grid.Row="2" SelectionMode="Multiple" AllowDrop="True"
                         SelectionChanged="AccountsList_SelectionChanged"
                         PreviewMouseLeftButtonDown="AccountsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AccountsList_PreviewMouseMove" Drop="AccountsList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3,4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Group}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                                <Button Grid.Column="1" Click="ToggleFavorite_Click" ToolTip="Favorite"
                                        AutomationProperties.Name="Favorite" VerticalAlignment="Center"
                                        Margin="5,0,5,0" Padding="5" Focusable="False">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="☆" />
                                            <Setter Property="Foreground" Value="#7D8598" />
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                                            <Setter Property="FontSize" Value="19" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#F5C451" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Content" Value="★" />
                                                    <Setter Property="Foreground" Value="#F5C451" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button x:Name="AddAccountButton" Content="Add account" Click="AddAccount_Click" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Select all" Click="SelectAllAccounts_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="Select none" Click="SelectNoAccounts_Click" Style="{StaticResource CompactButton}" Margin="4,0,0,0" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EditAccountButton" Content="Edit profile" Click="EditAccount_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="↑" ToolTip="Move profile up" Click="MoveAccountUp_Click" Style="{StaticResource CompactButton}" Width="34" Margin="0,0,5,0" />
                        <Button Grid.Column="2" Content="↓" ToolTip="Move profile down" Click="MoveAccountDown_Click" Style="{StaticResource CompactButton}" Width="34" />
                    </Grid>
                    <Button x:Name="RemoveAccountButton" Content="Remove selected" Click="RemoveAccount_Click"
                            Style="{StaticResource DangerButton}" Margin="0,8,0,0" />
                    <TextBlock Text="Each account has its own browser session." TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="3,13,3,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Column="2" ClipToBounds="True" LayoutUpdated="WorkspaceGrid_LayoutUpdated">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BrowserRow" Height="*" MinHeight="180" />
                <RowDefinition Height="12" />
                <RowDefinition x:Name="ActivityRow" Height="190" MinHeight="150" />
            </Grid.RowDefinitions>

            <Grid x:Name="WorkspaceHeader" Margin="0,2,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Roblox Account Manager" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Choose a game, then launch your selected accounts."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,12,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Plugins" Click="Plugins_Click" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                    <Button Content="Settings" Click="Settings_Click" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                    <Button Content="Diagnostics" Click="Diagnostics_Click" Style="{StaticResource CompactButton}" />
                </StackPanel>
            </Grid>

            <Border x:Name="PresetPanel" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game preset" FontSize="12" Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Launch target" FontSize="12" Margin="12,0,0,6" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="GamePicker" Grid.Row="1" SelectionChanged="GamePicker_SelectionChanged"
                              AutomationProperties.Name="Game preset" MinWidth="160" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0">
                        <TextBox x:Name="CustomUrlBox" Visibility="Collapsed" Text="https://www.roblox.com/games/"
                                 AutomationProperties.Name="Custom Roblox game URL" />
                        <Border x:Name="PresetHint" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <TextBlock x:Name="PresetHintText" Text="Using the selected game preset"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>
                    </Grid>
                    <Button x:Name="AutoLaunchButton" Grid.Row="1" Grid.Column="2" Content="Launch selected" Click="PrepareLaunch_Click"
                            Style="{StaticResource PrimaryButton}" MinWidth="132" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="PresetSearchBox" TextChanged="PresetSearch_TextChanged" ToolTip="Search game presets"
                                     AutomationProperties.Name="Search game presets" Padding="8,5" />
                            <TextBlock Text="Search presets" Foreground="{StaticResource MutedTextBrush}" Margin="9,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PresetSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <WrapPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                            <Button x:Name="AddGamePresetButton" Content="Add" ToolTip="Add game preset" Click="AddGamePreset_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                            <Button x:Name="EditGamePresetButton" Content="Edit" ToolTip="Edit selected preset" Click="EditGamePreset_Click" Style="{StaticResource CompactButton}" IsEnabled="False" Margin="0,0,4,0" />
                            <Button x:Name="DuplicateGamePresetButton" Content="Duplicate" ToolTip="Duplicate selected preset" Click="DuplicateGamePreset_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                            <Button x:Name="RemoveGamePresetButton" Content="Remove" ToolTip="Remove selected preset" Click="RemoveGamePreset_Click" Style="{StaticResource CompactButton}" IsEnabled="False" Margin="0,0,4,0" />
                            <Button Content="Import" ToolTip="Import presets" Click="ImportGamePresets_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0" />
                            <Button Content="Export" ToolTip="Export presets" Click="ExportGamePresets_Click" Style="{StaticResource CompactButton}" />
                        </WrapPanel>
                        <Button x:Name="OpenLoginButton" Grid.Column="2" Content="Open Roblox" ToolTip="Open the selected account's Roblox login or home page"
                                Click="OpenLogin_Click" Style="{StaticResource CompactButton}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource ElevatedBrush}" Margin="0">
                        <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveProfileText" Text="No profile selected" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="  /  Roblox" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="Stack" Tag="stack" Click="ArrangeWindows_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" ToolTip="Stack undocked Roblox windows on one monitor without focusing them"/>
                            <Button Content="Grid" Tag="grid" Click="ArrangeWindows_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" Margin="6,0,0,0" ToolTip="Tile undocked Roblox windows across all monitors without focusing them"/>
                            <Button Content="Reset" Tag="reset" Click="ArrangeWindows_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" Margin="6,0,0,0" ToolTip="Put arranged Roblox windows back where they were, including minimized or maximized"/>
                            <Border Width="1" Height="18" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                            <Button x:Name="BrowseViewButton" Content="Browse" Click="BrowseView_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="14,5" IsEnabled="False" ToolTip="Roblox session browser"/>
                            <Button x:Name="ClientsViewButton" Content="Clients" Click="ClientsView_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="14,5" Margin="6,0,0,0" ToolTip="Embedded clients (opt-in per profile)"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="LaunchProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                    <Grid x:Name="BrowserHost" Grid.Row="2" Background="{StaticResource AppBackgroundBrush}">
                        <StackPanel x:Name="BrowserPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Select an account profile" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Text="Open Roblox to sign in or browse games."
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <local:ClientsPanel x:Name="ClientsPanel" Grid.Row="2" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- The whole 12px gap between the panels is the grab target; only a
                 thin line in the middle is drawn. -->
            <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeNS" ToolTip="Drag to resize the activity log"
                          AutomationProperties.Name="Resize activity log">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border Height="2" VerticalAlignment="Center" CornerRadius="1"
                                    Background="{StaticResource BorderBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Timeout" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="LaunchTimeoutPicker" Width="82" Height="30" Padding="8,4"
                                      SelectedIndex="1" Margin="0,0,7,0">
                                <ComboBoxItem Content="30s" Tag="30" />
                                <ComboBoxItem Content="45s" Tag="45" />
                                <ComboBoxItem Content="60s" Tag="60" />
                                <ComboBoxItem Content="90s" Tag="90" />
                            </ComboBox>
                            <CheckBox x:Name="ContinueOnFailureCheckBox" Content="Continue on failure" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="CancelLaunchButton" Content="Cancel" Style="{StaticResource CompactButton}"
                                    Click="CancelLaunch_Click" IsEnabled="False" Margin="0,0,6,0" />
                            <Button x:Name="RetryFailedButton" Content="Retry failed" Style="{StaticResource CompactButton}"
                                    Click="RetryFailed_Click" IsEnabled="False" Margin="0,0,6,0" />
                            <Button Content="Copy log" Style="{StaticResource CompactButton}" Click="CopyActivity_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="LaunchQueueList" Grid.Row="1" Margin="0,0,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,7" Width="160" Margin="0,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource FocusBrush}" />
                                            <TextBlock Text="  •  " FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Width="84" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource MutedTextBrush}"
                             BorderThickness="0" Padding="10,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
