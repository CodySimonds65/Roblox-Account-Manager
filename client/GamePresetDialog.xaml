<Window x:Class="RobloxAltClient.GamePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add game preset" Height="360" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create game preset" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Give the game a name and paste its Roblox game-page URL."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,17" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="GAME NAME" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,6" />
            <TextBox x:Name="GameNameBox" MaxLength="60" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="ROBLOX GAME URL" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,6" />
            <TextBox x:Name="GameUrlBox" MaxLength="2048" Text="https://www.roblox.com/games/" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Width="90" Margin="0,16,8,0" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="Add preset" Width="104" Margin="0,16,0,0" Click="Add_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
