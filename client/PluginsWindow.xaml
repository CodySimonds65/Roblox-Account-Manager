<Window x:Class="RobloxAltClient.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugins" Height="680" Width="900" MinHeight="560" MinWidth="720"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Plugins" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Text="Standalone extensions run in their own process and use only the capabilities you grant."
                   Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,34,0,18" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INSTALL FROM URL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="InstallUrlBox" Margin="0,7,0,0" Height="34" VerticalContentAlignment="Center"
                             ToolTip="Paste the base URL containing plugin.json, plugin.sha256, plugin.sig, and plugin.zip." />
                </StackPanel>
                <Button Grid.Column="1" Content="Install" Click="Install_Click" Margin="10,18,0,0" Padding="20,7" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="INSTALLED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,8" />
                <ItemsControl x:Name="InstalledList" />
                <TextBlock Text="AVAILABLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,20,0,8" />
                <ItemsControl x:Name="AvailableList" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Padding="20,7" Margin="0,14,0,0" />
    </Grid>
</Window>
