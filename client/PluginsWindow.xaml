<Window Style="{StaticResource {x:Type Window}}" x:Class="RobloxAltClient.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugins" Height="680" Width="900" MinHeight="560" MinWidth="720"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Plugins" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Text="Manage extensions and their permissions."
                   Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,32,0,18" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Install from URL" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="InstallUrlBox" Margin="0,7,0,0" Height="34" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Plugin URL" ToolTip="Paste a plugin installation URL." />
                </StackPanel>
                <Button Grid.Column="1" Content="Install" Style="{StaticResource PrimaryButton}" Click="Install_Click" Margin="10,22,0,0" Padding="20,7" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Installed" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="InstalledList" />
                <TextBlock Text="No plugins installed." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=InstalledList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Available" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8" />
                <ItemsControl x:Name="AvailableList" />
                <TextBlock Text="All catalog plugins are installed." Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=AvailableList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Padding="20,7" Margin="0,14,0,0" />
    </Grid>
</Window>
