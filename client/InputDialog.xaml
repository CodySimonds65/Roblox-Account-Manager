<Window x:Class="RobloxAltClient.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account profile" Height="285" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171923" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Account label" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox x:Name="LabelBox" Grid.Row="1" />
        <TextBlock Grid.Row="2" Text="Group (optional)" FontWeight="SemiBold" Margin="0,12,0,8" />
        <TextBox x:Name="GroupBox" Grid.Row="3" />
        <CheckBox x:Name="FavoriteBox" Grid.Row="4" Content="Favorite profile" Margin="0,12,0,0" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Width="90" Margin="0,12,8,0" Click="Cancel_Click" Background="#3C4054" />
            <Button x:Name="SaveButton" Content="Save" Width="90" Margin="0,12,0,0" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Window>
