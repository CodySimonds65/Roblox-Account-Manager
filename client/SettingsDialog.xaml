<Window x:Class="RobloxAltClient.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher settings" Width="570" MinHeight="590" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Launcher settings" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Stored locally on this PC." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="17">
            <StackPanel>
                <CheckBox x:Name="UpdateChecksBox" Content="Check GitHub for updates at startup" Margin="0,0,0,12" />
                <CheckBox x:Name="ContinueOnFailureBox" Content="Continue the queue after a failed account" Margin="0,0,0,12" />
                <CheckBox x:Name="RememberSelectionsBox" Content="Remember selected profiles and game" Margin="0,0,0,18" />

                <TextBlock Text="Roblox process timeout" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="TimeoutBox" Margin="0,0,0,14">
                    <ComboBoxItem Content="30 seconds" Tag="30" />
                    <ComboBoxItem Content="45 seconds" Tag="45" />
                    <ComboBoxItem Content="60 seconds" Tag="60" />
                    <ComboBoxItem Content="90 seconds" Tag="90" />
                </ComboBox>

                <TextBlock Text="Delay between accounts" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="DelayBox" Margin="0,0,0,14">
                    <ComboBoxItem Content="No delay" Tag="0" />
                    <ComboBoxItem Content="2 seconds" Tag="2" />
                    <ComboBoxItem Content="5 seconds" Tag="5" />
                    <ComboBoxItem Content="10 seconds" Tag="10" />
                </ComboBox>

                <TextBlock Text="Preferred launcher" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="LauncherBox" Margin="0,0,0,14">
                    <ComboBoxItem Content="Windows registered handler (recommended)" Tag="Auto" />
                    <ComboBoxItem Content="Bloxstrap" Tag="Bloxstrap" />
                    <ComboBoxItem Content="Standard Roblox" Tag="Standard" />
                </ComboBox>

                <Separator Margin="0,3,0,12" />
                <CheckBox x:Name="ClearToolsBox" Content="Clear downloaded Sysinternals tool cache when saved" Margin="0,0,0,10" />
                <CheckBox x:Name="ClearSessionsBox" Content="Clear all Roblox browser sessions on next restart" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" Width="90" />
        </StackPanel>
    </Grid>
</Window>
