<UserControl x:Class="RobloxAltClient.GameSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Roblox game settings" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Graphics quality, FPS, and volume mirror Roblox's menu on the next launch. MSAA, texture quality, scaling, and advanced flags are engine overrides."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,14" />

                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Anti-aliasing (MSAA)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="MsaaBox" Grid.Column="1" Margin="10,0,0,10">
                            <ComboBoxItem Content="Automatic" Tag="" />
                            <ComboBoxItem Content="Off" Tag="0" />
                            <ComboBoxItem Content="2x" Tag="2" />
                            <ComboBoxItem Content="4x" Tag="4" />
                            <ComboBoxItem Content="8x" Tag="8" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Preserve rendering quality" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox x:Name="PreserveQualityBox" Grid.Row="1" Grid.Column="1"
                                  IsThreeState="False" Margin="10,0,0,10" Checked="PreserveQuality_Checked"
                                  Unchecked="PreserveQuality_Unchecked" VerticalContentAlignment="Center">
                            <TextBlock Text="Prevent Windows display scaling from reducing render quality"
                                       TextWrapping="Wrap" MaxWidth="330" />
                        </CheckBox>

                        <TextBlock Grid.Row="2" Text="Graphics quality" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="GraphicsQualityBox" Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                            <ComboBoxItem Content="Automatic" Tag="" />
                            <ComboBoxItem Content="Level 1 · Minimum" Tag="1" />
                            <ComboBoxItem Content="Level 2" Tag="2" />
                            <ComboBoxItem Content="Level 3" Tag="3" />
                            <ComboBoxItem Content="Level 4" Tag="4" />
                            <ComboBoxItem Content="Level 5" Tag="5" />
                            <ComboBoxItem Content="Level 6" Tag="6" />
                            <ComboBoxItem Content="Level 7" Tag="7" />
                            <ComboBoxItem Content="Level 8" Tag="8" />
                            <ComboBoxItem Content="Level 9" Tag="9" />
                            <ComboBoxItem Content="Level 10 · Maximum" Tag="10" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="Texture quality (engine)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="TextureQualityBox" Grid.Row="3" Grid.Column="1" Margin="10,0,0,10">
                            <ComboBoxItem Content="Automatic" Tag="" />
                            <ComboBoxItem Content="Level 0 · Minimum" Tag="0" />
                            <ComboBoxItem Content="Level 1" Tag="1" />
                            <ComboBoxItem Content="Level 2" Tag="2" />
                            <ComboBoxItem Content="Level 3" Tag="3" />
                            <ComboBoxItem Content="Level 4" Tag="4" />
                            <ComboBoxItem Content="Level 5" Tag="5" />
                            <ComboBoxItem Content="Level 6 · Maximum" Tag="6" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="Maximum frame rate" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="Updates Roblox's native in-game frame-rate setting on the next launch." />
                        <Grid Grid.Row="4" Grid.Column="1" Margin="10,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="FpsBox" SelectionChanged="FpsBox_SelectionChanged">
                                <ComboBoxItem Content="Automatic" Tag="" />
                                <ComboBoxItem Content="60 FPS" Tag="60" />
                                <ComboBoxItem Content="120 FPS" Tag="120" />
                                <ComboBoxItem Content="144 FPS" Tag="144" />
                                <ComboBoxItem Content="165 FPS" Tag="165" />
                                <ComboBoxItem Content="240 FPS" Tag="240" />
                                <ComboBoxItem Content="Custom" Tag="Custom" />
                            </ComboBox>
                            <TextBox x:Name="CustomFpsBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="30 to 1000 FPS" />
                        </Grid>

                        <TextBlock Grid.Row="5" Text="Master volume" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="Applies Roblox's master game volume for this settings scope." />
                        <ComboBox x:Name="VolumeBox" Grid.Row="5" Grid.Column="1" Margin="10,0,0,10">
                            <ComboBoxItem Content="Automatic" Tag="" />
                            <ComboBoxItem Content="0% · Muted" Tag="0" />
                            <ComboBoxItem Content="10%" Tag="1" />
                            <ComboBoxItem Content="20%" Tag="2" />
                            <ComboBoxItem Content="30%" Tag="3" />
                            <ComboBoxItem Content="40%" Tag="4" />
                            <ComboBoxItem Content="50%" Tag="5" />
                            <ComboBoxItem Content="60%" Tag="6" />
                            <ComboBoxItem Content="70%" Tag="7" />
                            <ComboBoxItem Content="80%" Tag="8" />
                            <ComboBoxItem Content="90%" Tag="9" />
                            <ComboBoxItem Content="100%" Tag="10" />
                        </ComboBox>

                        <TextBlock Grid.Row="6" Text="Client scaling" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="ClientScalingBox" Grid.Row="6" Grid.Column="1" Margin="10,0,0,10"
                                  SelectionChanged="ClientScalingBox_SelectionChanged">
                            <ComboBoxItem Content="Automatic" Tag="Auto" />
                            <ComboBoxItem Content="Preserve quality" Tag="Preserve" />
                        </ComboBox>

                        <TextBlock Grid.Row="7" Text="Advanced engine flags" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Button Content="Format JSON" Click="FormatFlags_Click" Style="{StaticResource CompactButton}" Margin="0,0,7,0" />
                                <Button Content="Reset custom flags" Click="ResetFlags_Click" Style="{StaticResource CompactButton}" />
                            </StackPanel>
                            <TextBox x:Name="AdvancedFlagsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" MinHeight="90" FontFamily="Cascadia Mono"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="TipText" Text="Tip: Automatic removes only that override. Curated controls take priority over duplicate advanced flags."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="3,10,3,28" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ValidationText" Grid.Row="1" Foreground="#FF9BAA" TextWrapping="Wrap" Margin="3,8,3,0" />
    </Grid>
</UserControl>
